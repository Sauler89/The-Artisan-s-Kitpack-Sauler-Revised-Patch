// Berserker Revised KIT v0.1.0-alpha2
// Standalone rework of the stock BERSERKER kit for BG2EE / EET.

APPEND ~splprot.2da~ ~BRK_ENR 0x112 104 1~ UNLESS ~BRK_ENR~
COPY_EXISTING ~splprot.2da~ ~override~
  COUNT_2DA_COLS brk_sp_cols
  READ_2DA_ENTRIES_NOW brk_sp_rows brk_sp_cols
  SET brk_enr_row = 0 - 1
  FOR (brk_r = 0; brk_r < brk_sp_rows; ++brk_r) BEGIN
    READ_2DA_ENTRY_FORMER brk_sp_rows brk_r 0 brk_sp_name
    PATCH_IF (~%brk_sp_name%~ STRING_EQUAL_CASE ~BRK_ENR~) BEGIN
      SET brk_enr_row = brk_r
    END
  END
  PATCH_IF (brk_enr_row < 0) BEGIN
    PATCH_FAIL ~Berserker Revised KIT: BRK_ENR SPLPROT row was not found after append.~
  END
BUT_ONLY

ACTION_FOR_EACH brk_res IN
  ~BRKIE1~ ~BRKIE7~ ~BRKIE10~ ~BRKIE14~ ~BRKIE20~
  ~BRKO1~ ~BRKO2~ ~BRKO3~ ~BRKD1~ ~BRKD2~ ~BRKD3~
  ~BRKM1~ ~BRKM2~ ~BRKM3~
  ~BRKS1~ ~BRKS2~ ~BRKS3~
  ~BRKR1~ ~BRKR2~ ~BRKR3~ ~BRKX1~ ~BRKX2~ ~BRKX3~
  ~BRKL1~ ~BRKL2~ ~BRKL3~
BEGIN
  COPY_EXISTING ~spcl321.spl~ ~override/%brk_res%.spl~
    LPF BRK_CLEAR_EFFECTS END
    WRITE_LONG 0x08 0xffffffff
    WRITE_LONG 0x0c 0xffffffff
  BUT_ONLY
END

COPY_EXISTING ~brkie1.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 321 target = 2 timing = 1 resist_dispel = 2 parameter2 = 0 insert_point = 0 STR_VAR resource = ~SPCL322~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 9 resist_dispel = 2 parameter2 = 3 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 232 target = 2 timing = 9 resist_dispel = 2 parameter1 = 0 parameter2 = 20 special = 76 STR_VAR resource = ~BRKO1~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 232 target = 2 timing = 9 resist_dispel = 2 parameter1 = 0 parameter2 = 20 special = 50 STR_VAR resource = ~BRKO2~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 232 target = 2 timing = 9 resist_dispel = 2 parameter1 = 0 parameter2 = 20 special = 26 STR_VAR resource = ~BRKO3~ END
BUT_ONLY

COPY_EXISTING ~brkd1.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 285 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 1 END
BUT_ONLY
COPY_EXISTING ~brkd2.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 285 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 2 END
BUT_ONLY
COPY_EXISTING ~brkd3.spl~ ~override~
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 285 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 4 END
BUT_ONLY

COPY_EXISTING ~brko1.spl~ ~override~
  LPF BRK_ADD_CLEANUP STR_VAR r1=~BRKO1~ r2=~BRKO2~ r3=~BRKO3~ d1=~BRKD1~ d2=~BRKD2~ d3=~BRKD3~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 284 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 1 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 285 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 1 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 0 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 2 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 resist_dispel = 0 parameter1 = 0 parameter2 = brk_enr_row STR_VAR resource = ~BRKD1~ END
BUT_ONLY

COPY_EXISTING ~brko2.spl~ ~override~
  LPF BRK_ADD_CLEANUP STR_VAR r1=~BRKO1~ r2=~BRKO2~ r3=~BRKO3~ d1=~BRKD1~ d2=~BRKD2~ d3=~BRKD3~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 284 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 2 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 285 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 2 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 0 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 3 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 1 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 6 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 resist_dispel = 0 parameter1 = 0 parameter2 = brk_enr_row STR_VAR resource = ~BRKD2~ END
BUT_ONLY

COPY_EXISTING ~brko3.spl~ ~override~
  LPF BRK_ADD_CLEANUP STR_VAR r1=~BRKO1~ r2=~BRKO2~ r3=~BRKO3~ d1=~BRKD1~ d2=~BRKD2~ d3=~BRKD3~ END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 284 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 4 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 285 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 4 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 0 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 4 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 1 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 1 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 resist_dispel = 0 parameter1 = 0 parameter2 = brk_enr_row STR_VAR resource = ~BRKD3~ END
BUT_ONLY
