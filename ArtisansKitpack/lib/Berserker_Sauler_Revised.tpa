  LPF ADD_SPELL_EFFECT INT_VAR opcode = 0   target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 4 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 1   target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter1 = 1 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 142 target = 2 timing = 0 duration = 12 resist_dispel = 2 parameter2 = c0ber#ic END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 326 target = 2 timing = 1 resist_dispel = 0 parameter2 = srber_enr_row STR_VAR resource = ~C0BRD3~ END
BUT_ONLY

