// ---------------------------------------------------------------------------
// Berserker CLAB. Preserve Artisan Fighter Overhaul inheritance by keeping the
// upstream CLABFI01 -> CLABFI02 model, then replace the old Berserker package with
// the Sauler controllers and stock SPCL321 Enrage uses.
// ---------------------------------------------------------------------------
COPY_EXISTING ~CLABFI01.2DA~ ~OVERRIDE/CLABFI02.2DA~
  // Keep upstream Fighter Overhaul integration policy unchanged unless the Sauler
  // revision explicitly says otherwise.
  REPLACE_TEXTUALLY ~GA_C0FIG02~ ~**** ~ // Expertise
  REPLACE_TEXTUALLY ~GA_C0ARC03~ ~**** ~ // Rapid Shot
  REPLACE_TEXTUALLY ~AP_C0ARC03Z~ ~**** ~
  REPLACE_TEXTUALLY ~AP_C0FIG04~ ~**** ~ // Fighter Overhaul specialization passive

  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1  STR_VAR f_Entry = AP_C0BRI1  END
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 7  STR_VAR f_Entry = AP_C0BRI7  END
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 10 STR_VAR f_Entry = AP_C0BRI10 END
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 14 STR_VAR f_Entry = AP_C0BRI14 END
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 20 STR_VAR f_Entry = AP_C0BRI20 END
  LPF set_clab_2da_entries INT_VAR f_MinLevel = 1 f_Increment = 4 STR_VAR f_Entry = GA_SPCL321 END

  PRETTY_PRINT_2DA
BUT_ONLY

// ---------------------------------------------------------------------------
// Enrage: keep the stock one-turn / Winded chassis and +15 temporary HP, remove
// flat combat bonuses and overbroad immunities, and normalize the intended state.
// SPCL321D is deliberately untouched.
// ---------------------------------------------------------------------------
OUTER_SET srber_charm_state = IDS_OF_SYMBOL (~splstate~ ~CHARM_IMMUNITY~)
OUTER_SET srber_conf_state  = IDS_OF_SYMBOL (~splstate~ ~CONFUSION_IMMUNITY~)
OUTER_SET srber_hold_state  = IDS_OF_SYMBOL (~splstate~ ~HOLD_IMMUNITY~)
OUTER_SET srber_panic_state = IDS_OF_SYMBOL (~splstate~ ~PANIC_IMMUNITY~)
OUTER_SET srber_sleep_state = IDS_OF_SYMBOL (~splstate~ ~SLEEP_IMMUNITY~)
OUTER_SET srber_stun_state  = IDS_OF_SYMBOL (~splstate~ ~STUN_IMMUNITY~)
OUTER_SET srber_feeb_state  = IDS_OF_SYMBOL (~splstate~ ~FEEBLEMIND_IMMUNITY~)

COPY_EXISTING ~spcl321.spl~ ~override~
  // Flat vanilla/legacy combat package. In Extremis now owns all combat scaling.
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 0 END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 54 END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 73 END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 284 END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 285 END

  // Normalize intended Enrage immunities before re-adding exactly one copy each.
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 5   END // charm
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 128 END // confusion
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 24  END // fear
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 175 END // hold
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 109 END // paralysis
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 39  END // sleep
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 217 END // unconsciousness
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 45  END // stun
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 210 END // Power Word: Stun
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 23  END // morale
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 106 END // morale break

  // Explicitly unsupported immunities.
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 76  END // feeblemind
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 211 END // imprisonment
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 213 END // maze
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 101 match_parameter2 = 216 END // level drain

  // EE Fixpack feedback/VFX paired with protections we deliberately removed.
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 296 STR_VAR match_resource = ~cdfeeble~ END
  PATCH_IF (srber_feeb_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = srber_feeb_state END
  END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 282 match_parameter1 = 1 match_parameter2 = 2 END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 267 match_parameter1 = 41495 END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 267 match_parameter1 = 40968 END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 267 match_parameter1 = 40969 END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 267 match_parameter1 = 40979 END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 267 match_parameter1 = 41616 END

  // Intended one-turn immunities.
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 5   END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 128 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 24  END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 175 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 109 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 39  END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 217 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 45  END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 210 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 23  END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 106 END

  // Explicit Enraged state used by In Extremis' conditional damage/resistance deltas.
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = 104 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 104 END

  // Detectable-Spells states for SCS. Normalize first to avoid duplicate markers.
  PATCH_IF (srber_charm_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = srber_charm_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = srber_charm_state END
  END
  PATCH_IF (srber_conf_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = srber_conf_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = srber_conf_state END
  END
  PATCH_IF (srber_hold_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = srber_hold_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = srber_hold_state END
  END
  PATCH_IF (srber_panic_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = srber_panic_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = srber_panic_state END
  END
  PATCH_IF (srber_sleep_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = srber_sleep_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = srber_sleep_state END
  END
  PATCH_IF (srber_stun_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = srber_stun_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = srber_stun_state END
  END

  // Normalize and apply spellcasting lockout while Enraged.
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 145 match_parameter2 = 0 END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 145 match_parameter2 = 1 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 145 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 0 special = 1 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 145 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 1 special = 1 END

  SAY NAME1 ~Enrage~
  SAY UNIDENTIFIED_DESC ~Enrage
For 1 turn, the Berserker gains 15 temporary Hit Points and becomes immune to charm, confusion, fear, hold, paralysis, sleep, unconsciousness, stun, Power Word: Stun, and morale failure. Enrage does not protect against feeblemind, maze, imprisonment, level drain, or death effects. The Berserker cannot cast wizard or priest spells while Enraged. After Enrage ends, the normal Berserker Winded/cooldown period applies.~
BUT_ONLY

// ---------------------------------------------------------------------------
// Ranged weapon policy. Throwing axes/daggers/hammers remain governed by their
// melee weapon proficiencies; ranged-only groups are capped at one pip.
// ---------------------------------------------------------------------------
COPY_EXISTING ~weapprof.2da~ ~override~
  LPF srber_enforce_ranged_cap END
  PRETTY_PRINT_2DA
BUT_ONLY

// ---------------------------------------------------------------------------
// Kit description. Preserve upstream Fighter Overhaul-specific restrictions.
// ---------------------------------------------------------------------------
OUTER_SPRINT kit_description ~BERSERKER: Berserkers surrender discipline for raw violence, fighting more ferociously as wounds accumulate. Their strength is greatest at close range and under Enrage, but reckless swings and an open guard make low-health fighting genuinely dangerous.

Advantages:
– Immune to involuntary berserk effects.
– Gains In Extremis.

IN EXTREMIS: At 75% Hit Points or less, the Berserker suffers a -1 penalty to melee attack rolls, gains +1 melee damage, and suffers a 2-point Armor Class penalty. Below 50% Hit Points these values become -2 to hit, +2 damage, a 3-point Armor Class penalty, and +1/2 attack per round. At 25% Hit Points or less they become -4 to hit, +4 damage, a 4-point Armor Class penalty, and +1 attack per round. While Enraged, the melee damage bonuses double to +2/+4/+8.

– 7th level: In Extremis also grants +1/+2/+4 movement rate.
– 10th level: In Extremis also grants +1/+2/+4 to all Saving Throws.
– 14th level: In Extremis also grants 3%/6%/10% resistance to slashing, crushing, piercing, and missile damage. While Enraged, these totals double to 6%/12%/20%.
– 20th level: In Extremis grants no Luck bonus at the first tier, +1 Luck below 50% Hit Points, and +2 Luck at 25% Hit Points or less.
– May use Enrage once per day at 1st level and gains one additional use every 4 levels thereafter.

ENRAGE: For 1 turn, the Berserker gains 15 temporary Hit Points and becomes immune to charm, confusion, fear, hold, paralysis, sleep, unconsciousness, stun, Power Word: Stun, and morale failure. Enrage does not protect against feeblemind, maze, imprisonment, level drain, or death effects. The Berserker cannot cast wizard or priest spells while Enraged. After Enrage ends, the normal Berserker Winded/cooldown period applies.

Disadvantages:
– May not Specialize in ranged-only weapon categories.KIT_DISADV_1
– Alignment restricted to any non-lawful.~

ACTION_IF MOD_IS_INSTALLED ~Setup-ArtisansKitpack.tp2~ ~1100~ THEN BEGIN
  OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
    REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~
– May not use Expertise or Rapid Shot.
– Does not gain Specialization in all weapons at 16th level.~
  END
END ELSE BEGIN
  OUTER_PATCH_SAVE kit_description ~%kit_description%~ BEGIN
    REPLACE_TEXTUALLY ~KIT_DISADV_1~ ~~
  END
END

LAF ~GET_KIT_STRREF~ STR_VAR kit_name = ~BERSERKER~ RET kit_strref END
STRING_SET_EVALUATE kit_strref ~%kit_description%~

// HLA policy: deliberately do not modify LUABBR/LUFI0, do not remove Hardiness,
// and do not install Artisan's Extend Rage. S&A #710/#720 can therefore extend
// the Fighter HLA pool and patch SPCL907 without a conflict from this component.
