  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 39  END // sleep
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 217 END // unconsciousness
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 45  END // stun
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 210 END // Power Word: Stun
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 23  END // morale
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 101 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 106 END // morale break

  // Mark Rage explicitly for the In Extremis opcode-326 branches.
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = 104 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 special = 1 parameter2 = 104 END

  // Interoperability markers for AI/scripting systems. Resolve symbols dynamically.
  // Normalize stock/EE Fixpack copies first so the final spell exposes one canonical
  // marker per intended immunity. Missing symbols resolve to -1 and are skipped.
  PATCH_IF (brk_charm_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = brk_charm_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 special = 1 parameter2 = brk_charm_state END
  END
  PATCH_IF (brk_conf_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = brk_conf_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 special = 1 parameter2 = brk_conf_state END
  END
  PATCH_IF (brk_hold_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = brk_hold_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 special = 1 parameter2 = brk_hold_state END
  END
  PATCH_IF (brk_panic_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = brk_panic_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 special = 1 parameter2 = brk_panic_state END
  END
  PATCH_IF (brk_sleep_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = brk_sleep_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 special = 1 parameter2 = brk_sleep_state END
  END
  PATCH_IF (brk_stun_state >= 0) BEGIN
    LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 328 match_parameter2 = brk_stun_state END
    LPF ADD_SPELL_EFFECT INT_VAR opcode = 328 target = 2 timing = 0 duration = 60 resist_dispel = 2 special = 1 parameter2 = brk_stun_state END
  END

  // A raging dual/multiclass character cannot cast arcane or divine spells.
  // Normalize prior copies first so no older/longer casting lock survives.
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 145 match_parameter2 = 0 END
  LPF DELETE_EFFECT INT_VAR silent = 1 multi_match = 1 match_opcode = 145 match_parameter2 = 1 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 145 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 0 special = 1 END
  LPF ADD_SPELL_EFFECT INT_VAR opcode = 145 target = 2 timing = 0 duration = 60 resist_dispel = 2 parameter2 = 1 special = 1 END

  SAY NAME1 @300
  SAY UNIDENTIFIED_DESC @301
BUT_ONLY

// -----------------------------------------------------------------------------
// 10. Ranged proficiency policy: stock EE + Skills and Abilities 5.4.
//     S&A consolidates bows into BOW and crossbows/darts/slings into MISSILE.
//     THROWN and ARCHERY are S&A style proficiencies and remain available normally.
// -----------------------------------------------------------------------------
COPY_EXISTING ~weapprof.2da~ ~override~
  LPF BRK_ENFORCE_RANGED_CAP END
  PRETTY_PRINT_2DA
BUT_ONLY

// -----------------------------------------------------------------------------
// 11. Localized stock-kit description. Keep the vanilla BERSERKER row/kit id,
//     but replace its help text with the Revised rules.
// -----------------------------------------------------------------------------
LAF BRK_GET_KIT_STRREF STR_VAR kit_name = ~BERSERKER~ RET brk_kit_strref = kit_strref END
ACTION_IF (brk_kit_strref >= 0) BEGIN
  OUTER_SPRINT brk_kit_text @200
  STRING_SET_EVALUATE brk_kit_strref ~%brk_kit_text%~
END ELSE BEGIN
  OUTER_PATCH ~~ BEGIN
    PATCH_FAIL ~Berserker Revised KIT: could not resolve the BERSERKER kit description strref.~
  END
END
